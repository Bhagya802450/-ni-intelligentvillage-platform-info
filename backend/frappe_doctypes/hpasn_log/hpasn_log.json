{
  "doctype": "DocType",
  "name": "HPASN Exchange Audit Log",
  "module": "HP Agriculture Service Network",
  "custom": 0,
  "autoname": "format:TXN-ASN-{#####}",
  "read_only": 1,
  "description": "Cryptographically signed immutable audit record for HP-ASN inter-system data exchanges between Government Systems, Partner Systems, and Frappe/PostgreSQL.",
  "fields": [
    {
      "fieldname": "transaction_id",
      "label": "Transaction ID",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "who_requested",
      "label": "Who Requested? (Requester System / Entity)",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "what_data",
      "label": "What Data? (Cadastral / Soil / Crop Scope)",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "when",
      "label": "When? (Timestamp)",
      "fieldtype": "Datetime",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "why",
      "label": "Why? (Purpose / Regulatory Justification)",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "was_consent_required",
      "label": "Was Consent Required?",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "was_access_allowed",
      "label": "Was Access Allowed?",
      "fieldtype": "Check",
      "default": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "system_type",
      "label": "System Type (Government / Partner)",
      "fieldtype": "Select",
      "options": "GOVERNMENT\nPARTNER",
      "default": "GOVERNMENT"
    },
    {
      "fieldname": "farmer_id",
      "label": "Target Farmer ID",
      "fieldtype": "Link",
      "options": "Farmer"
    },
    {
      "fieldname": "consent_method",
      "label": "Consent Method",
      "fieldtype": "Data"
    },
    {
      "fieldname": "hash_signature",
      "label": "Cryptographic Hash Signature (HMAC-SHA256)",
      "fieldtype": "Data",
      "reqd": 1
    }
  ]
}
