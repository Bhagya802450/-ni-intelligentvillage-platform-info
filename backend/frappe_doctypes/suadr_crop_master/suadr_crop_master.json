{
  "name": "SUADR Crop Master",
  "doctype": "DocType",
  "module": "SUADR",
  "autoname": "format:CRPM-{crop_name}-{#####}",
  "is_submittable": 0,
  "track_changes": 1,
  "description": "Standardized statewide crop master repository in SUADR",
  "fields": [
    {
      "fieldname": "id",
      "fieldtype": "Data",
      "label": "Crop Master ID",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "crop_name",
      "fieldtype": "Data",
      "label": "Crop Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "crop_type",
      "fieldtype": "Select",
      "label": "Crop Classification",
      "options": "Horticulture / Fruit\nCereal Grain\nVegetable\nPulse\nPlantation / Cash Crop\nMedicinal & Aromatic",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "season",
      "fieldtype": "Select",
      "label": "Crop Season",
      "options": "Kharif\nRabi\nZaid\nPerennial",
      "reqd": 1,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Agriculture Officer",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Farmer",
      "read": 1
    }
  ]
}
