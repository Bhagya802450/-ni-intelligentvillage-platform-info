{
  "name": "SUADR Soil Data",
  "doctype": "DocType",
  "module": "SUADR",
  "autoname": "format:SOIL-{location}-{#####}",
  "is_submittable": 0,
  "track_changes": 1,
  "description": "Location-specific physical and chemical soil testing parameters stored in SUADR",
  "fields": [
    {
      "fieldname": "id",
      "fieldtype": "Data",
      "label": "Soil Record ID",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "location",
      "fieldtype": "Data",
      "label": "Location / District",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "soil_type",
      "fieldtype": "Select",
      "label": "Soil Type",
      "options": "Clay Loam\nSandy Loam\nLoam\nSilty Clay\nMountain Acidic Peat\nAlluvial",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "ph",
      "fieldtype": "Float",
      "label": "pH Level (0.0 - 14.0)",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "nitrogen",
      "fieldtype": "Float",
      "label": "Available Nitrogen (kg/ha)",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "phosphorus",
      "fieldtype": "Float",
      "label": "Available Phosphorus (kg/ha)",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "potassium",
      "fieldtype": "Float",
      "label": "Available Potassium (kg/ha)",
      "reqd": 1,
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Agriculture Officer",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Farmer",
      "read": 1
    }
  ]
}
