{
  "doctype": "DocType",
  "name": "Crop",
  "module": "HP Agriculture",
  "custom": 0,
  "autoname": "format:CROP-{#####}",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "crop_id",
      "label": "Crop ID",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "farmer_id",
      "label": "Farmer Reference",
      "fieldtype": "Link",
      "options": "Farmer",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "parcel_id",
      "label": "Land Parcel Reference",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "crop_name",
      "label": "Crop Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "variety",
      "label": "Cultivar / Variety",
      "fieldtype": "Data"
    },
    {
      "fieldname": "season",
      "label": "Agro Season",
      "fieldtype": "Select",
      "options": "Kharif\nRabi\nZaid\nPerennial",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sowing_date",
      "label": "Sowing / Planting Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "harvest_date",
      "label": "Estimated Harvest Date",
      "fieldtype": "Date"
    },
    {
      "fieldname": "area_bigha",
      "label": "Cultivated Area (Bighas)",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "crop_stage",
      "label": "Phenological Stage",
      "fieldtype": "Select",
      "options": "Sowing\nVegetative\nFlowering\nFruiting\nRipening\nHarvested",
      "default": "Vegetative",
      "in_list_view": 1
    },
    {
      "fieldname": "health_status",
      "label": "Crop Health",
      "fieldtype": "Select",
      "options": "Optimal\nModerate Stress\nSevere Stress",
      "default": "Optimal",
      "in_list_view": 1
    },
    {
      "fieldname": "estimated_yield_quintals",
      "label": "Estimated Yield (Quintals)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "actual_yield_quintals",
      "label": "Actual Harvested Yield (Quintals)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "ndvi_score",
      "label": "Sentinel-2 NDVI Score",
      "fieldtype": "Float",
      "default": "0.76"
    }
  ],
  "permissions": [
    {
      "role": "Agriculture Officer",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Farmer",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
