{
  "doctype": "DocType",
  "name": "Crop",
  "module": "HP Agriculture",
  "custom": 0,
  "autoname": "format:CROP-{#####}",
  "is_submittable": 0,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "id",
      "label": "Crop ID",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "land_id",
      "label": "Land Parcel ID (Parent Land)",
      "fieldtype": "Link",
      "options": "Land",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "crop_name",
      "label": "Crop Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "crop_type",
      "label": "Crop Type",
      "fieldtype": "Select",
      "options": "Horticulture / Fruit\nCereal Grain\nVegetable\nPulse\nPlantation / Cash Crop\nOilseed\nFodder",
      "default": "Horticulture / Fruit",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sowing_date",
      "label": "Sowing / Planting Date",
      "fieldtype": "Date",
      "in_list_view": 1
    },
    {
      "fieldname": "season",
      "label": "Agro Season",
      "fieldtype": "Select",
      "options": "Kharif\nRabi\nZaid\nPerennial",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "area",
      "label": "Cultivated Area (Bighas)",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "label": "Crop Status",
      "fieldtype": "Select",
      "options": "Sowing\nVegetative\nFlowering\nFruiting\nRipening\nHarvested",
      "default": "Vegetative",
      "in_list_view": 1
    },
    {
      "fieldname": "variety",
      "label": "Cultivar / Variety",
      "fieldtype": "Data"
    },
    {
      "fieldname": "estimated_yield_quintals",
      "label": "Estimated Yield (Quintals)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "actual_yield_quintals",
      "label": "Actual Harvested Yield (Quintals)",
      "fieldtype": "Float"
    },
    {
      "fieldname": "ndvi_score",
      "label": "Sentinel-2 NDVI Score",
      "fieldtype": "Float",
      "default": "0.78"
    }
  ],
  "permissions": [
    {
      "role": "Agriculture Officer",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Farmer",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
